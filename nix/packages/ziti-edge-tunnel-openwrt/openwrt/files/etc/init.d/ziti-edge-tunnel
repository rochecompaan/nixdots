#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=${ZITI_PROG:-/usr/bin/ziti-edge-tunnel}
INIT_SCRIPT=${ZITI_INIT_SCRIPT:-/etc/init.d/ziti-edge-tunnel}
WRAPPER=${ZITI_WRAPPER:-/usr/lib/ziti-edge-tunnel/run-managed}
CA_BUNDLE_HELPER=${ZITI_CA_BUNDLE_HELPER:-/usr/lib/ziti-edge-tunnel/update-ca-bundle}
DNSMASQ_HELPER=${ZITI_DNSMASQ_HELPER:-/usr/lib/ziti-edge-tunnel/update-dnsmasq}
RUNTIME_DIR=${ZITI_RUNTIME_DIR:-/tmp/ziti-edge-tunnel}
RESOLV_CONF=${ZITI_RESOLV_CONF:-/etc/resolv.conf}
# Grace period for the tunnel to exit after SIGTERM before SIGKILL.
# Must stay below the procd term_timeout (10s) so procd cannot SIGKILL
# this wrapper first and skip resolver cleanup.
STOP_TIMEOUT=${ZITI_STOP_TIMEOUT:-8}
DNS_CIDR=100.64.0.1/10
ZITI_DNS=100.64.0.2

log() {
        logger -t ziti-edge-tunnel -- "$*"
}

validate_dns_upstream() {
        dns_address=$1
        case "$dns_address" in
                ''|.*|*.|*..*|*[!0-9.]*) return 1 ;;
        esac

        dns_old_ifs=$IFS
        IFS=.
        set -- $dns_address
        IFS=$dns_old_ifs
        [ "$#" -eq 4 ] || return 1

        for dns_octet; do
                case "$dns_octet" in
                        0|[1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]) ;;
                        *) return 1 ;;
                esac
        done
}

load_ziti_config() {
        config_load ziti-edge-tunnel
        config_get_bool enabled main enabled 0
        config_get jwt_path main jwt /etc/openziti/enroll.jwt
        config_get identity_path main identity /etc/openziti/identities/router.json
        config_get dns_upstream main dns_upstream 127.0.0.1
        config_get verbose main verbose 3

        [ -n "$jwt_path" ] || { log 'JWT path is empty'; return 1; }
        [ -n "$identity_path" ] || { log 'identity path is empty'; return 1; }
        validate_dns_upstream "$dns_upstream" || {
                log "dns_upstream must be an IPv4 address: $dns_upstream"
                return 1
        }
        case "$verbose" in
                ''|*[!0-9]*) log 'verbose must be numeric'; return 1 ;;
        esac
}

validate_jwt() {
        [ -f "$jwt_path" ] && [ ! -L "$jwt_path" ] || {
                log "JWT is missing or is not a regular file: $jwt_path"
                return 1
        }

        # OpenWRT BusyBox has no stat applet; the first field of ls -ld is
        # the mode string under both BusyBox and coreutils. Word-splitting
        # is intentional and safe: the mode string is always field one.
        listing=$(ls -ld "$jwt_path") || return 1
        set -- $listing
        modes=$1
        case "$modes" in
                -r*) ;;
                *)
                        log "JWT is not owner-readable: $jwt_path"
                        return 1
                        ;;
        esac
        [ "${modes#????}" = "------" ] || {
                log "JWT permissions are too broad: $jwt_path"
                return 1
        }
}

prepare_identity() {
        identity_dir=${identity_path%/*}
        [ "$identity_dir" != "$identity_path" ] || {
                log "identity path has no parent directory: $identity_path"
                return 1
        }

        umask 077
        mkdir -p "$identity_dir" || return 1
        chmod 0700 "$identity_dir" || return 1

        [ ! -L "$identity_path" ] || {
                log "identity must not be a symbolic link: $identity_path"
                return 1
        }

        if [ -f "$identity_path" ]; then
                chmod 0600 "$identity_path" || return 1
                if [ -e "$jwt_path" ]; then
                        log 'identity already exists; leaving JWT untouched'
                fi
                return 0
        fi

        [ ! -e "$identity_path" ] || {
                log "identity exists but is not a regular file: $identity_path"
                return 1
        }
        validate_jwt || return 1

        if ! "$PROG" enroll --jwt "$jwt_path" --identity "$identity_path"; then
                rm -f "$identity_path"
                log 'enrollment failed; JWT preserved'
                return 1
        fi
        [ -s "$identity_path" ] || {
                rm -f "$identity_path"
                log 'enrollment produced no identity; JWT preserved'
                return 1
        }

        chmod 0600 "$identity_path" || return 1
        rm -f "$jwt_path" || {
                log 'identity created but JWT removal failed'
                return 1
        }
        log 'enrollment completed and JWT removed'
}

snapshot_resolver() {
        umask 077
        mkdir -p "$RUNTIME_DIR" || return 1
        chmod 0700 "$RUNTIME_DIR" || return 1
        if [ -r "$RESOLV_CONF" ]; then
                cp -L "$RESOLV_CONF" "$RUNTIME_DIR/resolv.conf.before" || return 1
                chmod 0600 "$RUNTIME_DIR/resolv.conf.before" || return 1
        fi
}

cleanup_resolver() {
        [ -f "$RESOLV_CONF" ] || return 0
        mkdir -p "$RUNTIME_DIR" || return 1
        cleaned="$RUNTIME_DIR/resolv.conf.cleaned"
        awk -v dns="$ZITI_DNS" '$0 != "nameserver " dns { print }' \
                "$RESOLV_CONF" >"$cleaned" || return 1
        cat "$cleaned" >"$RESOLV_CONF" || return 1
        rm -f "$cleaned" "$RUNTIME_DIR/resolv.conf.before"
}

stop_tunnel() {
        kill -TERM "$tunnel_pid" 2>/dev/null || return 0
        # Bounded grace period: SIGKILL the tunnel if it ignores SIGTERM so
        # the wrapper exits before procd's term_timeout SIGKILL, which would
        # orphan the tunnel and skip resolver cleanup.
        (
                sleep "$STOP_TIMEOUT"
                kill -KILL "$tunnel_pid" 2>/dev/null || true
        ) &
        watchdog_pid=$!
        wait "$tunnel_pid" 2>/dev/null || true
        kill "$watchdog_pid" 2>/dev/null || true
        wait "$watchdog_pid" 2>/dev/null || true
}

# run_managed must run in the same process procd supervises: procd signals
# only the PID it started (no process-group signal), so a subshell body here
# would orphan the tunnel and skip resolver cleanup on stop/restart.
run_managed() {
        trap 'cleanup_resolver' EXIT
        load_ziti_config || exit 1
        [ "$enabled" -eq 1 ] || exit 0
        prepare_identity || exit 1

        "$PROG" run \
                --identity "$identity_path" \
                --verbose "$verbose" \
                --dns-ip-range "$DNS_CIDR" \
                --dns-upstream "$dns_upstream" &
        tunnel_pid=$!
        trap 'stop_tunnel' TERM INT
        if wait "$tunnel_pid"; then
                status=0
        else
                status=$?
        fi
        trap - TERM INT
        exit "$status"
}

prepare_dnsmasq() {
        if ! "$DNSMASQ_HELPER" ensure; then
                log 'dnsmasq resolver preparation failed'
                return 1
        fi
}

refresh_ca_bundle() {
        if ! "$CA_BUNDLE_HELPER" ensure; then
                log 'Compaan CA bundle refresh failed'
                return 1
        fi
}

start_service() {
        load_ziti_config || return 1
        prepare_dnsmasq || return 1
        [ "$enabled" -eq 1 ] || return 0
        refresh_ca_bundle || return 1
        # Enrollment runs in the supervised process (run_managed). Only
        # validate local material here: OpenWrt runs start/stop from package
        # maintainer scripts, so they must stay fast and non-blocking.
        if [ ! -f "$identity_path" ]; then
                validate_jwt || return 1
        fi
        snapshot_resolver || return 1

        procd_open_instance ziti-edge-tunnel
        procd_set_param command "$WRAPPER"
        procd_set_param respawn 3600 5 5
        procd_set_param term_timeout 10
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance || {
                cleanup_resolver
                return 1
        }
}

stop_service() {
        cleanup_resolver
}

service_triggers() {
        procd_add_reload_trigger ziti-edge-tunnel
}
